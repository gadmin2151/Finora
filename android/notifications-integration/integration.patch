--- /dev/null
+++ b/android/app/src/main/java/work/gadmin/finora/notifications/FinoraMessagingService.kt
@@ -0,0 +1,32 @@
+package work.gadmin.finora.notifications
+
+import com.google.firebase.messaging.FirebaseMessagingService
+import com.google.firebase.messaging.RemoteMessage
+
+/** Copy through integration.patch only after Firebase configuration is available. */
+class FinoraMessagingService : FirebaseMessagingService() {
+    override fun onMessageReceived(message: RemoteMessage) {
+        // Server MUST send data-only. Notification payloads bypass this handler in background.
+        if (message.notification != null) return
+        PushRuntime.receiver?.invoke(message.data)
+    }
+
+    override fun onNewToken(token: String) {
+        PushRuntime.tokenRotated?.invoke(PushToken(token))
+    }
+
+    override fun onDeletedMessages() {
+        PushRuntime.messagesDeleted?.invoke()
+    }
+}
+
+/**
+ * Application installs callbacks synchronously, including process starts caused by FCM. No service
+ * networking: show a neutral notification immediately; fetch on explicit tap. Token callbacks
+ * should enqueue one-time lifecycle-owned work, never periodic polling.
+ */
+object PushRuntime {
+    @Volatile var receiver: ((Map<String, String>) -> Unit)? = null
+    @Volatile var tokenRotated: ((PushToken) -> Unit)? = null
+    @Volatile var messagesDeleted: (() -> Unit)? = null
+}
diff --git a/android/app/src/main/java/work/gadmin/finora/notifications/FirebasePushProvider.kt b/android/app/src/main/java/work/gadmin/finora/notifications/FirebasePushProvider.kt
new file mode 100644
--- /dev/null
+++ b/android/app/src/main/java/work/gadmin/finora/notifications/FirebasePushProvider.kt
@@ -0,0 +1,42 @@
+package work.gadmin.finora.notifications
+
+import com.google.firebase.FirebaseApp
+import com.google.firebase.messaging.FirebaseMessaging
+import kotlin.coroutines.resume
+import kotlin.coroutines.resumeWithException
+import kotlinx.coroutines.suspendCancellableCoroutine
+
+class FirebasePushProvider : PushProvider {
+    override val configured: Boolean
+        get() = runCatching { FirebaseApp.getInstance() }.isSuccess
+
+    override suspend fun token(): PushToken = suspendCancellableCoroutine { continuation ->
+        FirebaseMessaging.getInstance()
+            .apply { isAutoInitEnabled = true }
+            .token
+            .addOnCompleteListener { task ->
+                if (continuation.isActive) {
+                    if (task.isSuccessful) continuation.resume(PushToken(task.result))
+                    else
+                        continuation.resumeWithException(
+                            IllegalStateException("Push registration unavailable")
+                        )
+                }
+            }
+    }
+
+    override suspend fun deleteToken(): Unit = suspendCancellableCoroutine { continuation ->
+        FirebaseMessaging.getInstance()
+            .apply { isAutoInitEnabled = false }
+            .deleteToken()
+            .addOnCompleteListener { task ->
+                if (continuation.isActive) {
+                    if (task.isSuccessful) continuation.resume(Unit)
+                    else
+                        continuation.resumeWithException(
+                            IllegalStateException("Push revocation unavailable")
+                        )
+                }
+            }
+    }
+}
