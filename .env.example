# Reference only. Generate real credentials with: python3 scripts/init.py
COMPOSE_PROJECT_NAME=finora
COMPOSE_FILE=compose.yaml
COMPOSE_PROFILES=
# Set to ghcr.io/gadmin2151/finora:latest, a sha-* tag, or a registry digest.
FINORA_IMAGE=finora:local
BIND_ADDRESS=127.0.0.1
APP_PORT=8088
APP_URL=http://localhost:8088
COOKIE_SECURE=false
POSTGRES_PASSWORD=
SECRET_KEY=
ADMIN_USERNAME=admin
OLLAMA_URL=http://ollama:11434
AI_TIMEOUT=480
AI_CPU_THREADS=4
OLLAMA_MEMORY_LIMIT=6g
OLLAMA_CPUS=4
# For HTTPS also set COMPOSE_FILE=compose.yaml:compose.tls.yaml,
# APP_URL=https://your-domain and COOKIE_SECURE=true.
# DOMAIN=finance.example.com
